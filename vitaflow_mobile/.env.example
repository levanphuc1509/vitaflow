# ===== Bắt buộc khi chạy thật =====
APP_ENV=production                 # production: tắt dữ liệu demo, bật cookie Secure, bắt buộc SECRET_KEY
SECRET_KEY=                        # chuỗi ngẫu nhiên dài:  python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/vitaflow
BEHIND_PROXY=1                     # đứng sau nginx/Render/Fly/Railway (tin X-Forwarded-*)

# ===== Thông tin pháp lý hiển thị trong app/web =====
COMPANY_NAME=VitaFlow
SUPPORT_EMAIL=support@vitaflow.vn
SUPPORT_PHONE=1900 8888

# ===== Thanh toán VietQR =====
BANK_ID=MB
BANK_ACCOUNT=0000000000
BANK_ACCOUNT_NAME=CONG TY VITAFLOW

# ===== Push notification (tuỳ chọn) =====
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json   # Android (FCM)
APNS_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8                  # iOS: khoá .p8 tải từ Apple Developer
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_BUNDLE_ID=vn.VITAFLOW.app                                 # trùng appId trong mobile-app/capacitor.config.json
# APNS_USE_SANDBOX=1                                              # chỉ khi chạy Debug từ Xcode (TestFlight/App Store = production)

# ===== Tuỳ chọn khác =====
GEMINI_API_KEY=                    # thực đơn AI (không có thì dùng thực đơn offline)
# SEED_DEMO=1                      # CHỈ để thử nghiệm: nạp tài khoản demo ngay cả khi production
