{
  "appId": "vn.VITAFLOW.app",
  "appName": "VITAFLOW",
  "webDir": "www",
  "appendUserAgent": "VITAFLOWApp/1.0",
  "backgroundColor": "#F4F6F5",
  "server": {
    "url": "http://127.0.0.1:5000",
    "cleartext": true,
    "allowNavigation": ["127.0.0.1"],
    "errorPath": "offline.html"
  },
  "ios": { "contentInset": "never", "scheme": "VITAFLOW" },
  "android": { "allowMixedContent": true, "webContentsDebuggingEnabled": true },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "launchAutoHide": true, "backgroundColor": "#006039", "showSpinner": false },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}

